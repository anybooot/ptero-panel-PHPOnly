<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct browser access to sensitive system files and folders
    RewriteRule ^(\.env|\.git|src|views|database) - [F,L,NC]

    # If the request is not already pointing to public/, redirect internally to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to hidden files (.env, .gitignore, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
